# Phase 1 platform API defaults. Do not commit real secrets here.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://scuttlebutt:local-scuttlebutt-password@localhost:5433/scuttlebutt
GOOGLE_CLIENT_ID=
GOOGLE_CLOUD_PROJECT=scuttlebutt-504320

# Optional Web Push. Generate one stable VAPID key pair per deployment and keep the private key secret.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Optional client-side GIF and sticker search. Request a GIPHY API key at https://developers.giphy.com/.
VITE_GIPHY_API_KEY=

# Phase 6 local voice placeholders. Keep LiveKit signing secrets server-side.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=scuttlebutt-livekit-dev-secret
TURN_SHARED_SECRET=scuttlebutt-turn-dev-secret
