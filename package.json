{
  "name": "scuttlebutt",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm build && turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "matrix:prepare": "node scripts/prepare-matrix-dev.mjs",
    "matrix:up": "docker compose -f infrastructure/matrix/docker-compose.yml up -d",
    "matrix:down": "docker compose -f infrastructure/matrix/docker-compose.yml down",
    "matrix:test": "node scripts/run-matrix-test.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test --config=apps/web/playwright.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "yaml": "2.8.1"
  }
}
